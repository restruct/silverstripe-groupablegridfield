{
    "name": "restruct/silverstripe-groupable-gridfield",
    "description": "Drag and drop grouping for Silverstripe GridFields: drag items between groups, reorder whole groups, and add, rename or remove groups in the grid, with groups from a MultiValueField or a DataObject relation",
    "type": "silverstripe-vendormodule",
    "keywords": [
        "silverstripe",
        "silverstripe-module",
        "silverstripe-cms",
        "gridfield",
        "grouping",
        "sortable",
        "drag-and-drop"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Restruct",
            "email": "dev@restruct.nl",
            "homepage": "https://restruct.nl"
        }
    ],
    "require": {
        "php": "^8.1",
        "silverstripe/framework": "^5 || ^6",
        "silverstripe/vendor-plugin": "^2 || ^3",
        "symbiote/silverstripe-gridfieldextensions": "^4 || ^5",
        "symbiote/silverstripe-multivaluefield": "^6 || ^7"
    },
    "require-dev": {
        "silverstripe/recipe-testing": "^3 || ^4"
    },
    "autoload": {
        "psr-4": {
            "Restruct\\Silverstripe\\GroupableGridfield\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Restruct\\Silverstripe\\GroupableGridfield\\Tests\\": "tests/"
        }
    },
    "extra": {
        "expose": [
            "client"
        ]
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/restruct"
        }
    ]
}
