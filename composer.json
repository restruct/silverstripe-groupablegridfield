{
    "name": "restruct/silverstripe-groupable-gridfield",
    "description": "Drag & drop grouping of items in a Silverstripe GridField, with groups from a MultiValueField or from a DataObject relation",
    "type": "silverstripe-vendormodule",
    "keywords": [
        "silverstripe",
        "gridfield",
        "grouping",
        "sortable"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Restruct web & apps",
            "email": "dev@restruct.nl"
        }
    ],
    "require": {
        "php": "^8.1",
        "silverstripe/framework": "^5 || ^6",
        "silverstripe/vendor-plugin": "^2 || ^3",
        "symbiote/silverstripe-gridfieldextensions": "^4 || ^5",
        "symbiote/silverstripe-multivaluefield": "^6 || ^7"
    },
    "require-dev": {
        "silverstripe/recipe-testing": "^3 || ^4"
    },
    "autoload": {
        "psr-4": {
            "Restruct\\Silverstripe\\GroupableGridfield\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Restruct\\Silverstripe\\GroupableGridfield\\Tests\\": "tests/"
        }
    },
    "extra": {
        "expose": [
            "client"
        ]
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/restruct"
        }
    ]
}
